# Declarative reward catalogue (example)
# Copy this file to registry/reward-functions.yaml and declare your reward
# identities. This file is METADATA ONLY: the kit never imports, evaluates, or
# executes an implementation named here — there is no reward loader.
# Validate: python3 build/check-reward-registry.py registry/reward-functions.yaml
# Read choreography/reward-registry.md for the field rules.
version: 1
rewards:
  - id: exact_match
    description: compare a scored answer with an expected reference answer
    input: scored_rollout_sample
    output: scalar
    min_score: 0
    max_score: 1
    deterministic: true
    modes: train,eval
    implementation_ref: project-local
    source: operator-documentation
  - id: format_adherence
    description: score whether an answer follows a declared output format
    input: scored_rollout_sample
    output: scalar
    min_score: 0
    max_score: 1
    deterministic: true
    modes: eval
    implementation_ref: project-local
    source: pending-verification
