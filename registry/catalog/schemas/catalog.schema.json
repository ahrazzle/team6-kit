{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team6-kit/registry/catalog/schemas/catalog.schema.json",
  "title": "Team6-kit compact skill catalog",
  "description": "A generated, compact, router-visible catalog. Each entry carries metadata and an exact local read path. It MUST NOT carry a skill body.",
  "type": "object",
  "required": ["schema_version", "catalog_id", "generated_from", "pack", "funnel_order", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "catalog_id": { "type": "string", "minLength": 1 },
    "generated_from": { "type": "string", "minLength": 1 },
    "pack": { "type": "string", "minLength": 1 },
    "pack_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "funnel_order": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "name", "funnel", "pack", "source", "license",
          "provenance", "read_path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "funnel": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "pack": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "license_source": { "type": "string", "enum": ["frontmatter", "pack-default"] },
          "provenance": { "type": "string", "minLength": 1 },
          "read_path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
